# ──────────────────────────────────────────────────
# AlgoViz — Environment Variable Template
# Copy the relevant section to the appropriate .env
# file in frontend/, backend/, or execution-service/
# ──────────────────────────────────────────────────

# ── Frontend (frontend/.env) ──────────────────────
# Base URL of the Express backend.
# Local:      http://localhost:5000
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:5000

# ── Backend (backend/.env) ────────────────────────
# Port for the Express server
PORT=5000

# URL of the Python execution service
# Local:      http://localhost:8000
# Production: https://your-execution-service.onrender.com
EXECUTION_SERVICE_URL=http://localhost:8000

# Allowed CORS origin (frontend URL)
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# ── Execution Service (execution-service/.env) ────
# Maximum seconds a user script is allowed to run
SANDBOX_TIMEOUT_SECONDS=5

# Maximum memory the sandbox may use (Docker only)
SANDBOX_MAX_MEMORY_MB=128
